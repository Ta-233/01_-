<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>わんこジャンプ</title>
<style>
body{
  margin:0;
  overflow:hidden;
  background:#87ceeb;
  touch-action:manipulation;
}
canvas{
  display:block;
  width:100vw;
  height:100vh;
}
</style>
</head>
<body>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

function resize(){
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
resize();
window.addEventListener("resize", resize);

const dog = {
  x: 80,
  y: 0,
  width: 60,
  height: 60,
  velocityY: 0,
  jumping: false
};

let groundY;
let obstacles = [];
let score = 0;
let speed = 4;
let gameOver = false;
let frame = 0;

function setupGround(){
  groundY = canvas.height - 120;
  dog.y = groundY - dog.height;
}
setupGround();

function jump(){
  if(!dog.jumping && !gameOver){
    dog.velocityY = -16;
    dog.jumping = true;
  }

  if(gameOver){
    restart();
  }
}

document.addEventListener("touchstart", jump);
document.addEventListener("mousedown", jump);
document.addEventListener("keydown", e=>{
  if(e.code==="Space" || e.code==="ArrowUp"){
    jump();
  }
});

function restart(){
  obstacles = [];
  score = 0;
  speed = 4;
  frame = 0;
  gameOver = false;
  setupGround();
  dog.velocityY = 0;
}

function drawDog(){
  ctx.font = "50px serif";
  ctx.fillText("🐶", dog.x, dog.y + 50);
}

function updateDog(){
  dog.velocityY += 0.8;
  dog.y += dog.velocityY;

  if(dog.y >= groundY - dog.height){
    dog.y = groundY - dog.height;
    dog.velocityY = 0;
    dog.jumping = false;
  }
}

function createObstacle(){
  obstacles.push({
    x: canvas.width,
    y: groundY - 40,
    width: 30,
    height: 40
  });
}

function updateObstacles(){
  obstacles.forEach(obstacle=>{
    obstacle.x -= speed;

    ctx.fillStyle = "#2e8b57";
    ctx.fillRect(
      obstacle.x,
      obstacle.y,
      obstacle.width,
      obstacle.height
    );

    if(
      dog.x + dog.width > obstacle.x &&
      dog.x < obstacle.x + obstacle.width &&
      dog.y + dog.height > obstacle.y
    ){
      gameOver = true;
    }
  });

  obstacles = obstacles.filter(o=>o.x > -50);
}

function drawGround(){
  ctx.fillStyle = "#7cfc00";
  ctx.fillRect(0, groundY, canvas.width, canvas.height-groundY);
}

function drawScore(){
  ctx.fillStyle = "#000";
  ctx.font = "28px Arial";
  ctx.fillText("スコア: " + score, 20, 40);

  ctx.fillText(
    "スピード: " + speed.toFixed(1),
    20,
    80
  );
}

function drawGameOver(){
  ctx.fillStyle = "red";
  ctx.font = "40px Arial";
  ctx.textAlign = "center";

  ctx.fillText(
    "ゲームオーバー",
    canvas.width/2,
    canvas.height/2 - 20
  );

  ctx.font = "24px Arial";

  ctx.fillText(
    "画面をタップして再スタート",
    canvas.width/2,
    canvas.height/2 + 30
  );

  ctx.textAlign = "left";
}

function gameLoop(){
  ctx.clearRect(0,0,canvas.width,canvas.height);

  drawGround();

  if(!gameOver){

    updateDog();

    if(frame % 100 === 0){
      createObstacle();
    }

    updateObstacles();

    score++;

    if(frame % 300 === 0){
      speed += 0.5;
    }

    frame++;
  }

  drawDog();
  drawScore();

  if(gameOver){
    drawGameOver();
  }

  requestAnimationFrame(gameLoop);
}

gameLoop();
</script>
</body>
</html>
